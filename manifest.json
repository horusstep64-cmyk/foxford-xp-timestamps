{
  "manifest_version": 3,
  "name": "Foxford XP Timestamps",
  "version": "1.0.0",
  "description": "Shows every XP task in a Foxford recording and marks it on the timeline.",
  "content_scripts": [
    {
      "matches": [
        "https://foxford.ru/groups/*",
        "https://apps.foxford.ru/webinar/*",
        "https://apps.foxford.ru/webinar-foxford/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
